# Copy to `.env` and fill in. Never commit `.env`.
# Every variable maps to a field in backend/app/core/config.py.

# --- Runtime -------------------------------------------------------------------
# development | test | production. Production refuses to start without API_KEY.
ENVIRONMENT=development
LOG_LEVEL=INFO
# LOG_JSON=true                      # one JSON object per line (log shippers)

# --- Database (required) --------------------------------------------------------
# Local development:
DATABASE_URL=postgresql://rag:change-me@localhost:5432/rag_data
# Optional least-privilege role for LLM-generated SQL (see docs/security.md):
# QUERY_DATABASE_URL=postgresql://rag_readonly:change-me@localhost:5432/rag_data
# Used by docker compose (DATABASE_URL is then derived from these). URL-encode
# special characters if you also use the password in DATABASE_URL.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag_data

# --- LLM (required for queries) ---------------------------------------------------
# Any OpenAI-compatible endpoint. Pick ONE of the blocks below.
#
# A) Hosted: Groq (free keys: https://console.groq.com)
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
#
# B) Your own GPU via docker compose (`docker compose --profile ollama up -d`).
#    Local endpoints need no API key and cost nothing in the dashboard.
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b
# OLLAMA_MODEL=qwen2.5:7b             # what the ollama-pull helper downloads
# LLM_STRUCTURED_OUTPUT=json_schema   # constrained decoding: best for small models
# LLM_TIMEOUT_SECONDS=120
#
# C) vLLM (`docker compose --profile vllm up -d`)
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_MODEL=qwen2.5-7b-instruct       # = VLLM_SERVED_NAME
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# LLM_STRUCTURED_OUTPUT=json_schema
#
# D) llama.cpp server (`docker compose --profile llamacpp up -d`)
# LLM_BASE_URL=http://llamacpp:8080/v1
# LLM_MODEL=qwen2.5-7b-instruct       # llama.cpp serves whichever model it loaded
# LLAMACPP_MODEL=Qwen/Qwen2.5-7B-Instruct-GGUF:Q4_K_M
# LLM_STRUCTURED_OUTPUT=json_schema
#
# E) Ollama installed natively on the host, API in docker: use
#    LLM_BASE_URL=http://host.docker.internal:11434/v1 (or localhost outside docker).

# --- LLM behaviour (optional) --------------------------------------------------------
# LLM_STRUCTURED_OUTPUT=json_object   # json_schema | json_object | prompt
# LLM_STRUCTURED_MAX_ATTEMPTS=3       # retries feed validation errors back
# SQL_REPAIR_ATTEMPTS=1               # resend SQL that failed in the database
# VERIFICATION_MODE=hybrid            # off | heuristic | hybrid (adds an LLM judge)
# Prices in USD per 1M tokens, merged over the built-in table (hosted models only):
# LLM_PRICING={"openai/gpt-oss-120b": {"input": 0.15, "output": 0.60}}

# --- LLM caches (optional) -----------------------------------------------------------
# LLM_CACHE_ENABLED=true              # exact replay of validated replies
# SEMANTIC_CACHE_ENABLED=true         # reuse SQL for similar questions
# SEMANTIC_CACHE_THRESHOLD=0.92
# LLM_CACHE_TTL_SECONDS=3600
# LLM_CACHE_MAX_ENTRIES=1000

# --- API security -------------------------------------------------------------------
# Shared secret for the X-API-Key header. Empty disables auth (development only).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The Vite dev server and the nginx container attach it for the browser.
API_KEY=
# Only needed when the browser calls the API cross-origin (VITE_API_URL).
ALLOWED_ORIGINS=http://localhost:5173
# RATE_LIMIT_QUERY=20/minute
# RATE_LIMIT_ADMIN=5/hour
# EXPOSE_DOCS=true                   # serve /docs and /openapi.json

# --- Enrichment -----------------------------------------------------------------------
# ENRICHMENT_ENABLED=true
# The SEC asks for a contact in the User-Agent: https://www.sec.gov/os/accessing-edgar-data
SEC_EDGAR_USER_AGENT="RAG-Data-Platform you@example.com"

# --- Retrieval (optional) ----------------------------------------------------------------
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# FAISS_INDEX_PATH=data/faiss_index
# RETRIEVAL_HYBRID=true               # BM25 fused with dense search (RRF)
# RETRIEVAL_RERANK=true               # cross-encoder over the fused shortlist
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# RETRIEVAL_RERANK_CANDIDATES=12
# RETRIEVAL_RRF_K=60
# RETRIEVAL_MAX_TABLES=4
# MAX_RESULT_ROWS=500
# SQL_STATEMENT_TIMEOUT_MS=15000

# --- Ports (docker compose) ------------------------------------------------------------
# API_PORT=8000
# FRONTEND_PORT=8080
