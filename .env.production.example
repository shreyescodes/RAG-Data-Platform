# Production settings for the server. Copy to /opt/rag/.env on the VM:
#   cp .env.production.example .env && chmod 600 .env
# Never commit the real file. docker-compose.prod.yml forces ENVIRONMENT,
# EXPOSE_DOCS, ALLOWED_ORIGINS and FORWARDED_ALLOW_IPS, so they are not set here.
# Generate secrets with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# --- Public address ---------------------------------------------------------------
# Hostname only, no scheme (e.g. a free DuckDNS name: myname-rag.duckdns.org).
DOMAIN=
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=

# --- Database ---------------------------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=rag_data
# SELECT-only role for LLM-generated SQL. Created by deploy/create-readonly-role.sh.
# QUERY_DATABASE_URL=postgresql://rag_readonly:<password>@db:5432/rag_data

# --- LLM: Groq --------------------------------------------------------------------------
# A free-tier key cannot run up charges; when its quota is used up, Groq returns 429.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- API -------------------------------------------------------------------------------------
# 32+ random characters. nginx attaches it server-side; it never reaches the browser.
API_KEY=
# RATE_LIMIT_QUERY=10/minute          # per client IP
LOG_LEVEL=INFO

# --- Enrichment ------------------------------------------------------------------------------
# The SEC requires a real contact: https://www.sec.gov/os/accessing-edgar-data
SEC_EDGAR_USER_AGENT="RAG-Data-Platform you@example.com"
# Optional free key (https://www.openfigi.com/api): maps 13F CUSIPs to tickers
# about 10x faster on the first seed.
# OPENFIGI_API_KEY=
